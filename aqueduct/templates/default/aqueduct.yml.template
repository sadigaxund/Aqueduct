# aqueduct.yml — Engine Configuration Template
#
# Configures the Aqueduct engine: deployment, Spark, stores, probes, secrets,
# webhooks, and LLM agent connection. NOT a blueprint definition.
#
# Rename to aqueduct.yml and place in your project root (or pass with --config).
# All sections are optional — omitting this file entirely uses local Spark with
# DuckDB stores in .aqueduct/.
#
# Engine/session config resolves in three layers, lowest first: this file,
# then the Blueprint's own engine.<name>: block, then this invocation's
# -s/--set flags. So `-s engine.spark.conf.spark.sql.shuffle.partitions=800`
# wins over both, for that one run only — nothing is written back here. LLM
# policy (approval, forbidden_ops) belongs in each Blueprint's agent: block
# — not here.
#
# Usage:
#   aqueduct run blueprint.yml                       # auto-discovers aqueduct.yml in CWD
#   aqueduct run blueprint.yml --config aqueduct.yml
#   aqueduct validate aqueduct.yml                  # static check (no run)

aqueduct_config: "2.0"


# ── Deployment ────────────────────────────────────────────────────────────────

deployment:
  # engine: execution engine. Validated against the engines registered
  # through the aqueduct.engines entry-point group — currently: spark, duckdb.
  engine: spark

  # target: deployment target. Validated against engine.spark.master_url at
  # config-load; a mismatch raises a clear ConfigError naming both values and
  # the expected shape. Meaningful for engine: spark only.
  #   local | standalone | yarn | kubernetes — Aqueduct runs on the Spark driver (in-process).
  #   emr | dataproc — remote-submit targets planned for a future release;
  #   currently rejected at config-load with a "not yet supported" message.
  target: local

  # env: deployment environment tier.
  # local (default) — dev machine, no cluster validation.
  # cluster — standalone/YARN/K8s; doctor warns on relative store paths.
  # cloud   — future remote-submit targets (EMR/Dataproc); same validation as cluster.
  env: local
  # env: cluster


# ── Engine configuration (2.0) ────────────────────────────────────────────────
#
# Per-engine settings, namespaced by engine name. A key under engine.<name>.
# belongs to that engine; every other engine ignores it (accepted, warned,
# never a hard error — the same aqueduct.yml stays valid across engines).

engine:
  spark:
    # master_url: passed verbatim to SparkSession.builder.master(). Must match
    # deployment.target (validated at config-load):
    #   local       → starts with "local"   (e.g. local[*], local[4])
    #   standalone  → starts with "spark://" (e.g. spark://host:7077)
    #   yarn        → exactly "yarn"         (needs HADOOP_CONF_DIR / YARN_CONF_DIR)
    #   kubernetes  → starts with "k8s://"   (e.g. k8s://https://apiserver:443)
    master_url: "local[*]"

    # conf: any spark.* key accepted. Merged with the Blueprint's own
    # engine.spark.conf at runtime; Blueprint values win on conflict, and a
    # -s/--set flag on the invocation wins over both.
    conf: {}

      # ── Object storage — MinIO / S3-compatible ────────────────────────────
      # spark.hadoop.fs.s3a.endpoint: "http://minio:9000"
      # spark.hadoop.fs.s3a.path.style.access: "true"
      # spark.hadoop.fs.s3a.access.key: "@aq.secret('MINIO_ACCESS_KEY')"
      # spark.hadoop.fs.s3a.secret.key: "@aq.secret('MINIO_SECRET_KEY')"
      # spark.jars.packages: "org.apache.hadoop:hadoop-aws:3.3.4"

  # duckdb:
  #   # memory_limit / threads: SET at session creation. Unset keeps DuckDB's
  #   # own defaults (~80% of system RAM; all available cores).
  #   memory_limit: "4GB"
  #   threads: 4
  #
  #   # database_path: a persistent file, replacing the default :memory:
  #   # connection. LOCAL PATHS ONLY (rejected at config-load if given a
  #   # remote URI scheme) — raises the RAM ceiling on a receiving
  #   # cross-engine handoff island and lets large intermediates spill to
  #   # disk instead of aborting.
  #   database_path: "/data/aqueduct/run.duckdb"
  #
  #   # extension_repository: SET custom_extension_repository — the
  #   # airgapped/hermetic-CI escape hatch for DuckDB's httpfs extension,
  #   # which autoinstalls over the network on first s3://-style touch
  #   # otherwise. The other escape hatch (a pre-populated
  #   # ~/.duckdb/extensions directory) needs no config at all.
  #   extension_repository: "https://internal-mirror.example.com/duckdb-extensions"
  #
  #   # s3_key_id_secret / s3_secret_access_key_secret: SECRET KEY NAMES
  #   # (never literal credentials), resolved through the secrets: block
  #   # below — the same aqueduct.secrets.resolve_secret() @aq.secret()
  #   # uses — and fed into DuckDB's own CREATE SECRET via parameter
  #   # binding. Must be set together. s3_region is not sensitive.
  #   s3_key_id_secret: "AWS_ACCESS_KEY_ID"
  #   s3_secret_access_key_secret: "AWS_SECRET_ACCESS_KEY"
  #   s3_region: "us-east-1"
  #
  #   # s3_endpoint / s3_url_style / s3_use_ssl: the non-AWS-S3-compatible
  #   # escape hatch (MinIO, on-prem object storage) — NOT secrets, literal
  #   # values are fine. Without s3_endpoint, DuckDB resolves the bucket
  #   # against AWS's real S3 regardless of which credentials are configured.
  #   s3_endpoint: "minio:9000"
  #   s3_url_style: "path"
  #   s3_use_ssl: false

  # ── Object storage — AWS S3 (IAM role or key-pair) ──────────────────────────
  # spark.hadoop.fs.s3a.aws.credentials.provider: "com.amazonaws.auth.InstanceProfileCredentialsProvider"
  # spark.hadoop.fs.s3a.access.key: "@aq.secret('AWS_ACCESS_KEY_ID')"
  # spark.hadoop.fs.s3a.secret.key: "@aq.secret('AWS_SECRET_ACCESS_KEY')"
  # spark.jars.packages: "org.apache.hadoop:hadoop-aws:3.3.4"

  # ── Object storage — Google Cloud Storage ───────────────────────────────────
  # spark.hadoop.google.cloud.auth.service.account.enable: "true"
  # spark.hadoop.google.cloud.auth.service.account.json.keyfile: "/secrets/gcp-key.json"
  # spark.jars.packages: "com.google.cloud.bigdataoss:gcs-connector:hadoop3-2.2.11"

  # ── JDBC ────────────────────────────────────────────────────────────────────
  # spark.jars: "/opt/jars/postgresql-42.6.0.jar"
  # spark.jars.packages: "org.postgresql:postgresql:42.6.0"

  # ── Delta Lake ──────────────────────────────────────────────────────────────
  # spark.jars.packages: "io.delta:delta-spark_2.12:3.2.0"
  # spark.sql.extensions: "io.delta.sql.DeltaSparkSessionExtension"
  # spark.sql.catalog.spark_catalog: "org.apache.spark.sql.delta.catalog.DeltaCatalog"

  # ── Resource sizing ─────────────────────────────────────────────────────────
  # spark.driver.memory: "4g"
  # spark.executor.memory: "8g"
  # spark.executor.cores: "4"
  # spark.executor.instances: "10"
  # spark.sql.shuffle.partitions: "200"

  # ── Serialization ───────────────────────────────────────────────────────────
  # spark.serializer: "org.apache.spark.serializer.KryoSerializer"

  # ── Adaptive Query Execution (Spark 3+) ─────────────────────────────────────
  # spark.sql.adaptive.enabled: "true"
  # spark.sql.adaptive.coalescePartitions.enabled: "true"


# ── Stores ────────────────────────────────────────────────────────────────────
#
# Path resolution (1.1.0+): every relative path below resolves to THIS file's
# parent directory, never the CWD of `aqueduct`. URI values (s3://, postgresql://,
# redis://) and absolute paths pass through unchanged. Matches Compose / k8s /
# Terraform conventions.
#
# Each store is pluggable. Default DuckDB layout under .aqueduct/:
#   observability.db  — run records, failure contexts, signal overrides, probe
#                 signals, module + maintenance metrics, healing outcomes, AND
#                 column-level lineage (column_lineage)
#   depot.db    — depot KV store (@aq.depot.*), its own file per blueprint under
#                 .aqueduct/<blueprint_id>/, never inside
#                 observability.db
#
# Supported backends:
#   duckdb    — embedded; single-writer file. Suits local / dev / NFS.
#               Accepted by obs / depot.
#   postgres  — networked DSN; MVCC concurrent writers. Accepted by both
#               stores. With a shared DSN the engine creates `observability`
#               and `depot` schemas inside the target database.
#   redis     — depot-only KV; rejected at config-load for observability.
#
# `aqueduct stores info` prints the resolved backend per store.

stores:

  observability:
    backend: duckdb
    # DuckDB path = a routing base DIRECTORY (see specs §10.4.1):
    #   unset (default) → per-blueprint routing under
    #     .aqueduct/<blueprint_id>/observability.db (parallel-safe).
    #   a DIRECTORY, e.g. "/mnt/aqueduct/obs" → same per-blueprint split under
    #     your dir (parallel-safe, custom location).
    #   a FILE path (.db suffix) is a CONFIG ERROR — the single-shared-file
    #   layout was removed in 2.0 (never parallel-safe); for one shared
    #   concurrent store use backend: postgres below.
    # path: ".aqueduct"
    # Postgres example (uncomment + install `aqueduct-core[postgres]`) — MVCC,
    # fully concurrent, the right choice for parallel runs + live dashboards:
    # backend: postgres
    # path: "postgresql://aq@host:5432/aqueduct_db"

  # Depot — cross-run KV state (@aq.depot.*). A name-keyed MAP of mounts. The
  # `default` mount always exists even if omitted. A duckdb mount with NO `path`
  # is routed per blueprint to its own file at
  # .aqueduct/<blueprint_id>/depot.db; a mount with an explicit
  # `path` shares that one file across blueprints and is KEY-ISOLATED instead
  # (keys prefixed by blueprint_id). Either way blueprints never collide.
  # Read with @aq.depot.get('k') (default) / @aq.depot.<name>.get('k').
  depots:
    default:
      backend: duckdb
      # path: unset (default) → .aqueduct/<blueprint_id>/depot.db
      # path: ".aqueduct/depot.db"   # one shared file, keys prefixed per blueprint
      # backend: postgres
      # path: "postgresql://aq@host:5432/aqueduct_db"
      # Redis-only fast-path (uncomment + install `aqueduct-core[redis]`):
      # backend: redis
      # path: "redis://host:6379/0"
    # An extra, explicitly CROSS-BLUEPRINT mount (raw keys — the one place
    # collisions are possible; use postgres/redis for parallel writers).
    # `shared: true` always needs an explicit `path`: a per-blueprint file
    # cannot be shared, so leaving `path` unset is a config error.
    # fleet:
    #   backend: postgres
    #   path: "postgresql://aq@host:5432/fleet_db"
    #   shared: true

  # Object store for observability blobs (fat manifest/stack/provenance
  # columns) + the patch lifecycle (pending/applied/rejected). `local`
  # (default) keeps the on-disk layout; on a cluster point it at object
  # storage so an ephemeral pod leaves no local-FS artefacts.
  blob:
    backend: local
    # path: ""   # local: base dir (empty → blobs under the obs dir, patches under cwd)
    # Object-store example (uncomment + install `aqueduct-core[object-store]`):
    # backend: s3            # or gcs | adls
    # path: "s3://my-bucket/aqueduct"

  # benchmark — history store for `aqueduct benchmark` (disjoint from the
  # stores above; rows are not tied to a real run_id). Defaults to a DuckDB
  # file anchored to the scenarios directory; no need to set `path` for duckdb.
  benchmark:
    backend: duckdb
    # path: ".aqueduct/benchmark.duckdb"   # default: <scenarios_dir>/.aqueduct/benchmark.duckdb
    persist: true                          # write each (scenario, model) row
    gate_on_regression: false              # exit non-zero on any regression vs baseline
    # Postgres (uncomment + install `aqueduct-core[postgres]`); rows live in the `benchmark` schema:
    # backend: postgres
    # path: "postgresql://aq@host:5432/aqueduct_db"


# ── Checkpoints ───────────────────────────────────────────────────────────────
#
# `checkpoint: true` (module- or manifest-level, see blueprint.yml.template)
# writes module output to Parquet for `--resume`. By default it lands under
# the derived <store_dir>/checkpoints/ directory (same routing base as
# `stores.observability.path`). Uncomment to point checkpoints somewhere
# else instead — e.g. a faster local disk, or a directory shared between
# driver and workers on a Docker-based cluster.
#
# LOCAL FILESYSTEM PATHS ONLY — remote URI schemes (s3://, s3a://, gs://,
# hdfs://, abfss://, ...) are rejected at config-load. Remote checkpoint
# roots are not supported.
#
# checkpoint_root: "/mnt/fast-local/aqueduct-checkpoints"


# ── Cross-engine handoff (2.35) ─────────────────────────────────────────────
#
# A polyglot Blueprint (a module `engine:` field pins a DIFFERENT engine than
# an upstream module) gets a synthetic handoff module spliced in at each
# engine boundary — see blueprint.yml.template's `engine:` module-field note.
# The handoff spills the upstream island's output as parquet (fixed transport
# detail, not configurable here) at a location under `root`, then the
# downstream island reads it back. `root` must be reachable by BOTH engines —
# a local path, or a remote URI (s3://, gs://, abfss://, ...); unlike
# `checkpoint_root` above, a remote scheme is NOT rejected here. Layout:
# <root>/<manifest_hash>/<run_id>/<edge_id>/ — deleted on a successful run,
# kept on failure (when keep_on_failure is true) so a rerun after a self-heal
# reads the existing spill instead of recomputing the upstream island. A kept
# spill is released once a successful --resume has consumed it, or once a
# later run of the same blueprint has succeeded. There is no time-based
# expiry: retention is bounded by those actions, not by an age in days.
#
# Within a single polyglot run, a boundary's spill is also deleted EAGERLY —
# the moment every island that reads it has finished successfully, rather
# than waiting for the whole run to end — bounding peak spill storage on a
# long chain. Set prune_eagerly to false to defer every deletion to the
# run's own end instead (the end-of-run cleanup above still runs either way).
#
# handoff:
#   root: ".aqueduct/handoff"    # default
#   keep_on_failure: true        # default — the resume story
#   prune_eagerly: true          # default — delete a boundary's spill as
#                                 # soon as this run's own readers are done


# ── Polyglot session keep-alive ─────────────────────────────────────────────
#
# A polyglot Blueprint executes each island against its own engine session.
# By default the SAME engine recurring later in the run (e.g. spark ->
# duckdb -> spark) reuses the still-live session from its earlier island
# instead of closing and rebuilding one — skipping the rebuild cost (most
# significant for Spark). Session-scoped state the finishing island created
# (register_as_table catalog objects) is dropped at the boundary so the
# reused session stays observationally identical to a fresh one; every
# session is still closed by the time the run returns regardless of outcome.
#
# execution:
#   session_keep_alive: true    # default — false restores per-island close-every-time
#   share_island_state: false   # default — true skips the boundary cleanup,
#                                # deliberately sharing catalog state between
#                                # same-engine islands (only matters when
#                                # session_keep_alive is true)


# ── Universal session timezone (2.38) ───────────────────────────────────────
#
# Applied to EVERY registered engine's session at creation — Spark's
# spark.sql.session.timeZone, DuckDB's SET TimeZone. Engine-native tz
# settings already work standalone (engine.spark.conf.spark.sql.session.
# timeZone); this key only earns its keep once a Blueprint spans more than
# one engine, where a divergent per-engine session time zone silently
# changes to_timestamp()/cast results between islands. An explicit
# engine-native override always wins for that engine, and Aqueduct warns
# (rule_id engine_timezone_conflict) when the two disagree.
#
# timezone: "UTC"

# ── Cluster / Cloud deployment example ───────────────────────────────────────
#
# For YARN, Kubernetes, or Spark Standalone:
#
#   1. Set deployment.env: cluster (triggers doctor validation of store paths)
#   2. Set engine.spark.master_url to your cluster endpoint
#   3. Set all store paths to absolute paths on shared FS (NFS/EFS/PVC)
#      — driver CWD is ephemeral on YARN/K8s; relative paths lose data on restart
#   4. Move all hadoop FS credentials into engine.spark.conf (not Ingress options)
#
# Example (Spark Standalone + NFS shared store + S3A data):
#
# deployment:
#   target: standalone
#   env: cluster
#
# engine:
#   spark:
#     master_url: "spark://spark-master.internal:7077"
#     conf:
#       spark.executor.memory: "8g"
#       spark.executor.cores: "4"
#       spark.executor.instances: "20"
#       spark.jars.packages: "org.apache.hadoop:hadoop-aws:3.3.4,io.delta:delta-spark_2.12:3.2.0"
#       spark.sql.extensions: "io.delta.sql.DeltaSparkSessionExtension"
#       spark.sql.catalog.spark_catalog: "org.apache.spark.sql.delta.catalog.DeltaCatalog"
#
# stores:
#   observability:
#     backend: duckdb
#     path: "/mnt/nfs/aqueduct/observability"   # directory — per-blueprint files underneath
#   depots:
#     default:
#       backend: duckdb
#       path: "/mnt/nfs/aqueduct/depot.db"
#   spark.hadoop.fs.s3a.aws.credentials.provider: "com.amazonaws.auth.InstanceProfileCredentialsProvider"


# ── Probes ────────────────────────────────────────────────────────────────────
#
# Controls Probe signal collection behaviour engine-wide.
# Signal type config (which columns, fraction) belongs in each Blueprint's
# Probe module config.

probes:
  max_sample_rows: 100
  default_sample_fraction: 0.1

  # Probe signals that read a sample of the data (null_rates,
  # value_distribution, distinct_count, and row_count_estimate's sample
  # method on Spark) are GATED by `danger.allow_full_probe_actions` — default
  # false. Zero-cost signals (schema_snapshot, sample_rows; partition_stats
  # on Spark) always run. row_count_estimate is NOT gated on DuckDB — it is
  # an exact, sub-millisecond count on that engine, not a sampled estimate.
  # data_freshness is also suppressed unless allow_sample: true is set per-signal.


# ── Metrics ───────────────────────────────────────────────────────────────────
#
# Per-module observability tuning. Aqueduct uses Spark `DataFrame.observe()` to
# collect accurate per-module row counts; SparkListener stage metrics are also
# collected unconditionally.

metrics:
  # When true (default), wrap each Ingress read / Egress write with
  # `DataFrame.observe()` for accurate per-module records_read / records_written.
  # When false, fall back to SparkListener stage metrics only — slightly less
  # accurate (stage fusion blurs attribution) but avoids a ~5–15% throughput
  # regression on high-throughput pipelines where `observe()` can break
  # whole-stage codegen. See docs/SPARK_GUIDE.md ("DataFrame.observe() and
  # Whole-Stage Codegen") for the tradeoff.
  use_observe: true


# ── Secrets ───────────────────────────────────────────────────────────────────
#
# @aq.secret('KEY') in Blueprints resolves via secrets.provider below.
# "env" reads os.environ — works for local dev, CI, and secret-injected envs
# (Kubernetes Secrets, AWS SSM + env export, etc.).
#
# ── .env file auto-loading ────────────────────────────────────────────────────
#
# EVERY command (run/doctor/validate/test/report/runs/lineage/signal/heal/
# benchmark/patch preview/stores info) auto-discovers a `.env`
# in the directory of the config/blueprint you pass (NOT cwd) and loads it
# into os.environ before config parsing. Existing env vars are never
# overwritten. A `(env: loaded N var(s) from …)` line is printed to stderr.
#
# Drop a `.env` next to this aqueduct.yml to avoid manual `export`. Names
# must be either a real env var the code reads (e.g. ANTHROPIC_API_KEY)
# or referenced in this file via ${VAR} / @aq.secret('KEY') — arbitrary
# names do nothing on their own:
#   ANTHROPIC_API_KEY=sk-ant-...     # read directly by the agent
#   MINIO_ACCESS_KEY=...             # used below as ${MINIO_ACCESS_KEY}
#   MINIO_SECRET_KEY=...             # used below as ${MINIO_SECRET_KEY}
#
# Precedence: -e KEY=VAL  >  real env  >  <dir>/.env  >  --env-file  >  default
#   aqueduct run pipeline.yml -e RUN_ENV=staging      # inline override
#   aqueduct run pipeline.yml --env-file secrets/.env # explicit fallback
#   AQ_NO_ENV_FILE=1 aqueduct run pipeline.yml        # disable discovery (CI)
#
# ── Environment variable substitution in aqueduct.yml itself ─────────────────
#
# aqueduct.yml supports two substitution syntaxes expanded before YAML parsing:
#   ${VAR}            — os.environ["VAR"]; error if unset
#   ${VAR:-default}   — os.environ["VAR"] if set, else "default"
#   ${VAR:default}    — same (dash optional)
#   @aq.secret('KEY')— resolved via the configured secrets.provider.
#                      Two-pass load: ${VAR} expands first, then secrets.provider
#                      is validated, then @aq.secret() is dispatched to the
#                      configured backend (env / aws / gcp / azure / custom).
#                      No os.environ caching — every call hits the provider so
#                      rotation + per-call audit are preserved.
#
# Resolved @aq.secret() values are registered with aqueduct.redaction and
# scrubbed as [REDACTED] from console, observability rows, patch sidecar
# files, webhook bodies (headers/URL untouched), and LLM request payloads.
# Short / low-entropy values (len < 8 OR Shannon entropy < 2.5 bits/char)
# are NOT registered and emit AQ-WARN [secret-weak-redact] instead — they
# would false-match common identifiers.
#
# Use these to avoid hardcoding credentials in aqueduct.yml:
#   agent:
#     provider: ${AQUEDUCT_LLM_PROVIDER:-openai_compat}
#     model: "@aq.secret('AQUEDUCT_LLM_MODEL')"
#     base_url: "@aq.secret('AQUEDUCT_LLM_BASE_URL')"

secrets:
  provider: "env"           # env | aws | gcp | azure | custom
  # region: "us-east-1"    # required for aws/gcp/azure — cloud region
  # resolver: "mypackage.secrets.fetch"  # custom provider: dotted import path
                                          # fn(key: str) -> str | None

  # ── AWS Secrets Manager (pip install aqueduct-core[aws]) ─────────────────────
  # provider: "aws"
  # region: "us-east-1"
  # Requires boto3. boto3 default credential chain: env vars
  # (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY [+ AWS_SESSION_TOKEN]),
  # ~/.aws/credentials profile, IAM role on EC2/ECS/EKS/Lambda (IMDS), SSO.
  # Secrets are fetched on every @aq.secret('KEY') call — no caching, so
  # provider-side rotation takes effect on the next config load.
  # Short secret name (KEY) or full ARN both accepted.

  # ── GCP Secret Manager (pip install aqueduct-core[gcp]) ──────────────────────
  # provider: "gcp"
  # region: "us-central1"   # optional for GCP
  # Requires google-cloud-secret-manager. ADC or GOOGLE_APPLICATION_CREDENTIALS.
  # Short names require GCP_PROJECT or GOOGLE_CLOUD_PROJECT env var.

  # ── Azure Key Vault (pip install aqueduct-core[azure]) ───────────────────────
  # provider: "azure"
  # Requires azure-keyvault-secrets + azure-identity. DefaultAzureCredential used.
  # Requires AZURE_KEYVAULT_URL env var (e.g. https://myvault.vault.azure.net/).

  # ── Custom provider ───────────────────────────────────────────────────────────
  # provider: "custom"
  # resolver: "mypackage.secrets.fetch_secret"
  # Callable: (key: str) -> str | None  (None = fall back to os.environ)


# ── Webhooks ──────────────────────────────────────────────────────────────────
#
# Blueprint-level push notifications. Delivery is best-effort (daemon thread,
# one automatic retry on 429/5xx or network error); failures are logged and
# do not affect run outcome.
#
# Four hooks:
#   on_failure       — fires when a run ends with status="error"
#   on_success       — fires when a run ends with status="success"
#   on_patch_pending — fires when a patch is staged to patches/pending/
#   on_defer         — fires when a patch defers to a human (defer_to_human
#                      op) instead of proposing a fix. When unset, defers
#                      fall back to firing on_patch_pending, so nobody loses
#                      notifications on upgrade.
#
# Per-module webhook: set on_failure_webhook on any module in the Blueprint.
#   Fires when that module's retry policy is exhausted, regardless of whether
#   the blueprint continues (alert_only) or stops.
#
# Per-Assert-rule webhook: use on_fail: {action: webhook, url: ...} in each
#   Assert rule inside the Blueprint.
#
# Simple form — just a URL; sends the full context payload as JSON via POST:
#   webhooks:
#     on_failure: "https://hooks.slack.com/services/T.../B.../"
#     on_success: "https://hooks.example.com/blueprint-complete"
#
# Full form — custom method, headers, and payload template.
#
# on_failure template variables:
#   ${run_id}          UUID of this blueprint run
#   ${blueprint_id}     Blueprint identifier string
#   ${blueprint_name}   Blueprint display name
#   ${failed_module}   Module ID where the first failure occurred
#   ${error_message}   Human-readable error description
#   ${error_type}      Exception class name (e.g. AnalysisException)
#   ${started_at}      ISO-8601 run start timestamp
#   ${attempt}         Number of failed modules in this run
#
# on_success template variables:
#   ${run_id}          UUID of this blueprint run
#   ${blueprint_id}     Blueprint identifier string
#   ${blueprint_name}   Blueprint display name
#   ${module_count}    Number of modules executed
#
# on_patch_pending / on_defer template variables (the agent's
# structured diagnosis, no extra LLM calls):
#   ${run_id} ${blueprint_id} ${failed_module}
#   ${patch_id}        Staged patch identifier
#   ${root_cause}      Agent's root-cause analysis of the failure
#   ${rationale}       Why the proposed fix should work
#   ${confidence}      Agent self-rated confidence (e.g. "0.85", "n/a")
#   ${category}        Failure category label (schema_drift, bad_path, …)
#
# on_defer's full-payload (non-template) body additionally carries:
#   defer_reason       Queryable bucket: infrastructure |
#                       upstream_schema_change | data_shape_change |
#                       insufficient_context | other
#   diagnosis          Detailed explanation of why this can't be auto-patched
#   suggestions        Actionable next steps for the human operator
#   confidence_reason  Why the model is confident deferral is correct
#
# on_failure_webhook (per-module) template variables:
#   ${run_id}          UUID of this blueprint run
#   ${blueprint_id}     Blueprint identifier string
#   ${module_id}       ID of the module that failed
#   ${error_message}   Error description
#   ${error_type}      Exception class name
#
# ${ENV_VAR} in any value resolves to os.environ[VAR] (useful for secrets in headers).
#
# If payload is omitted, Aqueduct sends a standardized envelope:
#   {"event": "<hook name>", "timestamp": "<ISO-8601 UTC>",
#    "run_id": "...", "blueprint_id": "...", "data": {<event-specific payload>}}
# data carries the full FailureContext (on_failure), the success summary
# (on_success), or patch metadata + diagnosis (on_patch_pending).

webhooks:
  on_failure: null
  on_success: null

  # ── Slack — notify on failure ────────────────────────────────────────────────
  # on_failure:
  #   url: "${SLACK_WEBHOOK_URL}"
  #   method: POST
  #   payload:
  #     text: "Blueprint *${blueprint_id}* failed on `${failed_module}` — ${error_message}"

  # ── Slack — notify on success ────────────────────────────────────────────────
  # on_success:
  #   url: "${SLACK_WEBHOOK_URL}"
  #   method: POST
  #   payload:
  #     text: "Blueprint *${blueprint_id}* complete (${module_count} modules)  run_id=${run_id}"

  # ── PagerDuty Events API v2 ──────────────────────────────────────────────────
  # on_failure:
  #   url: "https://events.pagerduty.com/v2/enqueue"
  #   method: POST
  #   headers:
  #     Authorization: "Token token=${PAGERDUTY_INTEGRATION_KEY}"
  #   payload:
  #     routing_key: "${PAGERDUTY_INTEGRATION_KEY}"
  #     event_action: trigger
  #     payload:
  #       summary: "${blueprint_name} failed: ${error_message}"
  #       severity: critical
  #       source: "aqueduct/${blueprint_id}"
  #       custom_details:
  #         run_id: "${run_id}"
  #         failed_module: "${failed_module}"

  # ── Generic webhook — full context payload (no template) ─────────────────────
  # on_failure:
  #   url: "https://ops.example.com/api/v1/aqueduct-failure"
  #   method: POST
  #   headers:
  #     Authorization: "Bearer ${OPS_API_TOKEN}"   # endpoint auth (header is NOT redacted)
  #     X-Source: "aqueduct"
  #   timeout: 15
  #   # Optional hardening:
  #   secret: "${WEBHOOK_SIGNING_SECRET}"  # HMAC-SHA256-sign the body; receiver verifies
  #                                        # the X-Aqueduct-Signature: sha256=<digest> header
  #   max_retries: 2                       # retries on 429/5xx/network (default 1; 0 disables)
  #   backoff_seconds: 2.0                 # base backoff; exponential when max_retries > 1
  #   health_probe: options                # how `aqueduct doctor` probes this endpoint:
  #                                         #   connect — TCP/TLS reachability only, no HTTP request sent
  #                                         #   options — HTTP OPTIONS request (default); any response
  #                                         #             (incl. 405) counts as reachable
  #                                         #   full    — real POST/PUT/PATCH with a synthetic
  #                                         #             'doctor_probe' payload (pre-2.1 behaviour) —
  #                                         #             can trigger consumer-side side effects
  # Every delivery also carries an X-Aqueduct-Delivery: <uuid> header for receiver-side dedup.


# ── Heal-as-PR (`aqueduct patch pr`, 2.2.0) ──────────────────────────────────
#
# Connection-level mechanics for the `aqueduct patch pr <patch_ref>` command:
# apply a staged patch on a fresh branch, push it, and open a PR via the `gh`
# CLI (see `aqueduct doctor` for a `gh` presence/auth check). Not required for
# any other command — `patch apply`/`import`/`commit`/`rollback` all work
# without this section.
#
# No Blueprint influence over either block, ever: reviewer/label routing
# belongs to repo-level CODEOWNERS / branch protection, never to a healed
# pipeline's own config.

# git:
#   expected_root: null   # pin the git work-tree root patch pr / import / commit /
#                          # rollback are allowed to write into. Unset (default):
#                          # the resolved `git rev-parse --show-toplevel` must equal
#                          # this file's directory (the project root); a mismatch
#                          # (project nested inside a larger repo) hard-refuses.
#                          # Set this to make a monorepo layout explicit instead:
#                          #   expected_root: "/path/to/the/actual/repo/root"
#   remote: origin         # git remote `patch pr` pushes the heal branch to

# pr:
#   base_branch: main                                        # `gh pr create --base`
#   title_template: "aqueduct heal: {blueprint_id} ({module}) [{patch_id}]"
#   draft: false            # open as a draft PR


# ── LLM Agent — Connection Defaults ──────────────────────────────────────────
#
# Sets the provider, endpoint, and model for all blueprints that enable LLM
# self-healing. This is the ONLY place connection settings (provider,
# base_url, api_key, model, provider_options, timeout, cascade) can be
# configured — a Blueprint's agent: block cannot set or override any of
# them (a security boundary, not an oversight: the healing loop ships
# FailureContext — pruned manifest, provenance, error text — to whatever
# endpoint is configured here, so a
# Blueprint author does not get to redirect that traffic). Per-blueprint
# POLICY (approval, forbidden_ops, on_pending_patches, guardrails, ...)
# belongs in each Blueprint's agent: block — see blueprint.yml.template. A
# handful of policy fields (max_reprompts, prompt_context,
# max_heal_attempts_per_hour, patch_validation)
# are also settable here as the engine-wide default;
# a Blueprint's own value for one of those, when set, still wins.
#
# If a blueprint omits agent: entirely, LLM self-healing is disabled.

agent:
  # ── Anthropic (default) ────────────────────────────────────────────────────
  provider: "anthropic"              # "anthropic" | "openai_compat"
  model: "claude-sonnet-4-6"
  # api_key: "@aq.secret('ANTHROPIC_API_KEY')"  # optional; falls back to ANTHROPIC_API_KEY env var
  # ANTHROPIC_API_KEY env var required at runtime when api_key is unset

  # ── Timeouts and retries ──────────────────────────────────────────────────
  # timeout: 120.0              # HTTP socket timeout in seconds per agent call.
  #                             # Increase for slow local models (e.g. 600.0 for Qwen3-32B).
  # retry:                      # transient-error retry (HTTP 429/503/529, both providers).
  #   max_retries: 2            # extra attempts after the first call; 0 disables retry
  #   backoff_seconds: 2.0      # base backoff; attempt N sleeps ~2^N * base (+ jitter),
  #                             # honors server Retry-After, always capped by the remaining
  #                             # agent.budget.max_seconds deadline. Shared with `aqueduct benchmark`.
  # max_reprompts: 5            # single-axis cap; the unified loop also catches
  #                             # apply-gate rejections (guardrail / compile error) and
  #                             # feeds them back as reprompts. Use agent.budget below for
  #                             # finer-grained, multi-axis control.
  #                             # Does NOT retry on timeout/network failure (those abort immediately).

  # ── Multi-axis budget for the unified reprompt loop (1.1.0) ────────────────
  # First axis to trip terminates the loop. The terminal axis is recorded as
  # `stop_reason` in `heal_attempts` rows and on benchmark results — same
  # vocabulary across production and benchmark. `aqueduct benchmark` reads
  # this same block so the leaderboard runs under the production budget.
  #
  # budget:
  #   max_reprompts: 5            # max attempts (success counts as the terminating attempt)
  #   max_seconds: 120            # wall-clock cap across all attempts
  #   max_tokens_total: 50000     # null disables the axis
  #   same_error_consecutive: 2   # N identical signatures in a row → escalate (temp=0.8 + skeleton template)
  #                               # for ONE more attempt before tripping stuck_signature
  #   same_signature_overall: 3   # any signature repeating ≥ N times anywhere → stuck_signature
  #   progress_stalled_window: 3  # last N signatures identical → progress_stalled

  # ── Structured Spark error extraction (1.1.0) ──────────────────────────────
  # When the raised exception is a `PySparkException` / `Py4JJavaError`, the
  # Surveyor extracts the Spark `error_class`, offending column / table name,
  # `Did you mean ...?` suggestion list, and `SQLSTATE`. The LLM prompt renders
  # a focused "Root cause (structured)" block instead of the raw JVM stack
  # trace — substantially better recovery on small models. Persisted on
  # `failure_contexts.error_class / object_name / suggested_columns / sql_state
  # / root_exception`. Behaviour is automatic; no config knob required.

  # ── Custom prompt context ─────────────────────────────────────────────────
  # prompt_context: |           # Engine-wide context appended to LLM system prompt.
  #   This cluster runs Databricks. Use Delta Lake paths (dbfs:// or s3a://).
  #   All column names follow snake_case convention.
  #   Never reference local filesystem paths in config.path values.

  # ── Patch validation pyramid ───────────────────────────────────────────────
  # patch_validation controls how rigorously `auto` mode validates a
  # generated patch before writing it to the Blueprint on disk:
  #
  #   full_run (default, safest)
  #     the lineage gate (live sqlglot lineage diff) + the sandbox gate (sandbox replay against
  #     `--sample 1000` rows with Egress skipped) + full Spark run against the
  #     real Blueprint. Patch is written only when the full run succeeds.
  #
  #   sandbox
  #     the lineage gate + the sandbox gate only. Patch is written on sandbox pass without paying
  #     for a full real-data run. Fast unattended healing loop; lower
  #     confidence that the patch holds at production scale. Use only on
  #     pipelines whose data shape is well represented by the first 1000 rows.
  #
  # Per-blueprint override available via the Blueprint agent: block.
  # patch_validation: full_run

  # ── Chained multi-patch healing ─────────────────────────────────────────────
  # `agent.max_patches` (Blueprint-only, see blueprint.yml.template) is the
  # ONE counter for the whole heal: `max_patches: 1` (default) is a single
  # attempt; `max_patches: N` (N > 1) chains — a candidate patch that passes
  # its own validation but still leaves the pipeline failing is NOT discarded
  # when the new failure surfaces at a DIFFERENT module than the one just
  # patched, it folds into an accumulating multi-op patch and the next link
  # diagnoses the new failure. The SAME module failing again discards just
  # that candidate (already-proven links are kept) and retries. Nothing is
  # written to the Blueprint until the full accumulated patch passes the
  # pipeline end-to-end. Requires agent.sandbox_mode other than "off" when
  # max_patches > 1 (refused at run-start otherwise — chaining needs
  # per-link sandbox validation). Cascade tiers (below) never chain — each
  # tier still produces at most one patch per attempt.

  # ── Spend-cap on LLM healing attempts ──────────────────────────────────────
  # Surveyor counts rows written to observability.db `healing_outcomes` within the last
  # 60 minutes for the running blueprint. When the count is reached, the next
  # LLM HTTP call is skipped and the run ends with a clear stderr message.
  # Default null = unlimited. Per-blueprint override available via the
  # Blueprint agent: block (Blueprint value wins).
  # max_heal_attempts_per_hour: 10

  # ── Sandbox Spark master ───────────────────────────────────────────────────
  # Spark master URL for sandbox replay (patch preview). Default null uses
  # local[*] — 1000 sampled rows fit in any driver's memory. Set to
  # "spark://host:7077" or "yarn" when the blueprint is too large for a
  # single driver node.
  # sandbox_master_url: null

  # ── Ollama / vLLM / LM Studio (OpenAI-compatible endpoint) ────────────────
  # provider: "openai_compat"
  # base_url: "http://ollama.internal:11434/v1"   # /v1 suffix required
  # model: "deepseek-r1:14b"
  # timeout: 600.0              # large local models need more time
  # provider_options:

  # ── Multi-model cascade (CONNECTION — engine-level only) ───────────────────
  # A multi-model healing cascade tried in order; cheaper models first, escalate
  # on stuck/exhausted/deferred. A Blueprint cannot declare or override a
  # cascade (it is a connection concern, not a policy one — see
  # blueprint.yml.template's agent: block). No model: [list] shorthand here —
  # always write an explicit list of tiers.
  # cascade:
  #   - model: qwen2.5-coder:7b
  #     max_reprompts: 2
  #     max_seconds: 30
  #   - model: claude-sonnet-4-6
  #     max_reprompts: 3
  #     max_seconds: 120
  #     deep_loop: true
  #     allow_defer: true
  #   # Standard OpenAI params — merged into payload top-level (all openai_compat providers)
  #   temperature: 0.7
  #   top_p: 0.9
  #   # Ollama-specific params — prefix with ollama_ → stripped and nested under payload["options"]
  #   ollama_num_ctx: 16384      # context window; default 2048 silently truncates Aqueduct prompts
  #   ollama_num_thread: 16
  #   ollama_num_gpu: 0          # 0 = CPU only; 99 = all on GPU
  #   ollama_mlock: true         # lock weights in RAM (no swap)
  #   ollama_num_batch: 1024     # prompt eval batch size
  #   ollama_num_predict: -1     # -1 = no token limit
  #
  # Context window note: Ollama default num_ctx is 2048 tokens. Aqueduct
  # prompts (system prompt + failure context + envelope skeleton + reprompt
  # history) routinely exceed 4-6k; smaller windows silently truncate the
  # SYSTEM prompt, causing envelope-shape failures the reprompt loop can't
  # recover from. Set ollama_num_ctx to at least 8192 for 7B+ models (or
  # bake into the model server-side via Modelfile `PARAMETER num_ctx 16384`
  # + `ollama create`). VRAM cost: roughly +2-3 GB on a 7B at 16k, +15-20 GB
  # on a 70B — don't blanket-set across cascade tiers without budgeting.

# ── Warnings ──────────────────────────────────────────────────────────────────
# Aqueduct emits compile-time and session-startup diagnostics with the format
#     AQ-WARN [rule_id] message
# Copy the bracketed rule_id straight from the terminal into the suppress list
# below to silence one rule. The single entry "*" silences ALL warnings.
# CLI: `aqueduct --suppress-warning <id> run bp.yml` (or '*'); goes BEFORE the
# subcommand. Merged on top of this list.
#
# Per-blueprint scoping: a Blueprint YAML may also declare its own
# `warnings.suppress` (compile-time rules only — see blueprint.yml.template)
# — it is unioned with this engine-wide list for that blueprint's compile
# pass, without silencing the rule elsewhere.
#
# Available compile-time rule IDs (registry: aqueduct/compiler/warnings/):
#   kafka_checkpoint_stale, nondeterministic_fanout,
#   count_col_likely_count_star, file_format_no_repartition,
#   jdbc_missing_partition, custom_probe_driver_code,
#   spillway_port_mismatch
# Legacy compile-time rules, also suppressible:
#   delivery_append_retry_dupes, perf_probe_sample_full_scan,
#   perf_incremental_watermark_scan, perf_python_udf_row_at_a_time,
#   perf_delta_append_no_partition, perf_multi_consumer_no_cache,
#   perf_hadoop_fs_in_options, cross_engine_handoff_io
# (maintenance_optimize_non_delta was escalated to a compile ERROR —
#  deterministic runtime failure; not suppressible.)
# Session-startup rules (registry: aqueduct/executor/spark/warnings/):
#   jar_availability
#
# warnings:
#   suppress:
#     - count_col_likely_count_star
#     - jdbc_missing_partition
# # nuclear option — silence every Aqueduct warning:
# warnings:
#   suppress: ["*"]
#
# `warnings.strict` is the opposite direction: promote listed rule_ids from
# warning to a hard CompileError. Default empty (no behaviour change). E.g.
# to fail the build on an unvalidated cross-engine self-heal:
# warnings:
#   strict:
#     - cross_engine_heal

# ── Danger settings ───────────────────────────────────────────────────────────
# All default to false (safe production mode). Set to true only when needed.
# Aqueduct prints a startup warning for any active danger setting.
#
# danger:
#   allow_multi_patch: false          # if true, max_patches > 1 is allowed
#                                     # (multi-patch reprompt loop auto-applies patches
#                                     # without human review).
#   allow_full_probe_actions: false   # if true, Probes may run full-scan sampled actions
#                                     # (null_rates, value_distribution, distinct_count —
#                                     # same gate on both engines; DuckDB's row_count_estimate
#                                     # is exempt, it's an exact count regardless of this flag)
#                                     # adds latency; leave false in production
#   allow_full_preflight: false       # if true, agent.sandbox_mode: preflight is allowed
#                                     # (full-dataset sandbox replay, no Egress; slow but conclusive)
#   allow_skip_sandbox: false         # if true, agent.sandbox_mode: off is allowed
#                                     # (skip sandbox replay entirely; patches hit real data via
#                                     # the next execute(). Combine with max_patches > 1 at your own risk.)
#   allow_command_hooks: false        # if true, blueprint `hooks:` may use `command:` entries
#                                     # (arbitrary subprocess after on_success/on_failure).
#                                     # Gate lives HERE (operator-owned) so a blueprint cannot
#                                     # self-authorize shell execution. blueprint:/webhook: hook
#                                     # entries are declarative and never gated.
